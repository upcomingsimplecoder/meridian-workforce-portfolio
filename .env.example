# Generated local values are written by make setup. Never add .env to Git.
APP_ENV=local
RUNTIME_KIND=api
DATABASE_URL=
WORKER_DATABASE_URL=
OIDC_DATABASE_URL=
OIDC_ISSUER=http://127.0.0.1:4017
OIDC_CLIENT_ID=meridian-web
WEB_ORIGIN=http://127.0.0.1:3017
API_ORIGIN=http://127.0.0.1:8017
OIDC_REDIRECT_URI=http://127.0.0.1:3017/auth/callback
COOKIE_SECURE=false
AI_ENABLED=false
LOCAL_DATA_DIR=.local
STORAGE_BACKEND=local
# Hosted-only values belong in provider secret stores, never NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=meridian-artifacts
OBJECT_SIGNING_KEY=
STORAGE_TIMEOUT_SECONDS=15
OTEL_EXPORTER_OTLP_ENDPOINT=
