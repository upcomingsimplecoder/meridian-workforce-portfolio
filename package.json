{
  "name": "meridian",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/web",
    "apps/identity"
  ],
  "scripts": {
    "build": "npm run build -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "lint": "npm run lint -w apps/web",
    "test": "npm run test -w apps/web",
    "e2e": "playwright test",
    "contracts": "openapi-typescript packages/contracts/openapi.json -o packages/contracts/api.d.ts",
    "pree2e": ".venv/bin/python scripts/generate_workforce_fixtures.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "eslint": "10.12.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2"
  }
}
