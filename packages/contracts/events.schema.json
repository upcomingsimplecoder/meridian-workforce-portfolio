        {
          "$ref": "#/$defs/ScenarioEventPayload"
        },
        {
          "$ref": "#/$defs/CompProposalEventPayload"
        },
        {
          "$ref": "#/$defs/CompCycleEventPayload"
        },
        {
          "$ref": "#/$defs/TalentCycleEventPayload"
        },
        {
          "$ref": "#/$defs/AnalyticsEventPayload"
        },
        {
