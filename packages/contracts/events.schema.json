        "scenario.approved.v1",
        "comp.proposal_revision_created.v1",
        "comp.proposal_submitted.v1",
        "comp.proposal_returned.v1",
        "comp.cycle_locked.v1",
        "comp.export_created.v1",
        "talent.review_locked.v1",
